# ── Upstash Redis (for analytics) ─────────────────────────────────────────
# Get these from: https://console.upstash.com
# 1. Create a Redis database
# 2. Copy the REST URL and token from the database details page
UPSTASH_REDIS_REST_URL=your_upstash_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# ── Analytics dashboard protection ────────────────────────────────────────
# Visit /analytics?key=<this_value> to view your stats
# Use any strong random string. Generate one: openssl rand -hex 20
ANALYTICS_SECRET=change_me_to_a_strong_secret
